# Copy to .env and fill in as needed. Never commit the real .env file.

# Base URL of the MQL5 economic calendar
MQL5_BASE_URL=https://www.mql5.com

# Networking
MQL5_MAX_CONCURRENCY=3
MQL5_REQUEST_TIMEOUT_SECONDS=30
MQL5_MAX_RETRIES=4
MQL5_MIN_REQUEST_DELAY_SECONDS=1.0

# Optional TinyFish Browser API fallback (disabled unless both are set)
TINYFISH_ENABLED=false
TINYFISH_API_KEY=

# Storage
DATABASE_PATH=data/macro.db
EXPORT_DIR=data/exports

# UI
DEFAULT_LOCALE=en
