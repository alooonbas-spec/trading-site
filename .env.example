NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key

# Public origin used to build OAuth redirect URIs.
APP_URL=http://localhost:3000

# 32-byte key as 64 hex characters. Used to encrypt OAuth tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# VK ID (https://id.vk.ru)
VK_CLIENT_ID=
VK_SERVICE_TOKEN=

# X OAuth 2.0 (PKCE + Basic client_id:client_secret)
X_CLIENT_ID=
X_CLIENT_SECRET=

# Facebook Login / Graph API v25.0
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Instagram API with Instagram Login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
